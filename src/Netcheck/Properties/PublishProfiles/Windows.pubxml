<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained (user, P13, 2026-11-17): .NET is bundled, so the app runs on any 64-bit Windows 10/11 without
         installing Microsoft's .NET Desktop Runtime. It also loads its runtime only from its own (locked) folder. -->
    <SelfContained>true</SelfContained>
    <!-- One file (user, 2026-11-24, P14): everything in Netcheck.exe. Native libraries are not left to .NET's
         self-extraction (it unpacks to %TEMP%); NativeLibraries.cs unpacks them to a checked folder instead. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>../../artifacts/Netcheck/</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Netcheck.ProtectedDeployment" Value="Windows" />
    <RuntimeHostConfigurationOption Include="System.StartupHookProvider.IsSupported" Value="false" />
  </ItemGroup>
</Project>
