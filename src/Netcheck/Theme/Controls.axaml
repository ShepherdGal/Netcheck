<!-- Netcheck control themes. Each visual state has exactly one owner (the ControlTheme below),
     replacing Fluent's templates so hover/press never fight a second style layer. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FocusAdornerTemplate x:Key="NcFocus">
      <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="22" Margin="-3" />
    </FocusAdornerTemplate>

    <!-- Primary: the one main action on a screen. "B Soft" (user, 2026-11-25): stronger blue with a faint gradient, a light
         edge and an inner top highlight, drawn on a separate layer so the border never changes the button's size.
         Hover/pressed fade a white/black shade layer in and out, so the gradient itself never has to be animated. -->
    <ControlTheme x:Key="NcPrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource PrimaryFillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryInkBrush}" />
      <Setter Property="FontSize" Value="{StaticResource TextBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="20,11" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPrimary}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="FocusAdorner" Value="{StaticResource NcFocus}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    BorderBrush="{DynamicResource PrimaryEdgeBrush}" BorderThickness="1" BoxShadow="{DynamicResource PrimaryHighlight}">
              <Border.Transitions>
                <Transitions><BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" Easing="CubicEaseOut" /></Transitions>
              </Border.Transitions>
            </Border>
            <Border x:Name="Shade" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" /></Transitions>
              </Border.Transitions>
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="Center" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Shade"><Setter Property="Opacity" Value="0.10" /></Style>
      <Style Selector="^:pointerover /template/ Border#Fill"><Setter Property="BoxShadow" Value="{DynamicResource PrimaryHighlightHover}" /></Style>
      <Style Selector="^:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Shade">
        <Setter Property="Background" Value="Black" />
        <Setter Property="Opacity" Value="0.10" />
      </Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
      <Style Selector="^.big">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Padding" Value="34,13" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPrimaryBig}" />
      </Style>
    </ControlTheme>

    <!-- Quiet: secondary actions. "A Flat" (user, 2026-11-25): blue-tinted glass, blue hairline, no highlight. -->
    <ControlTheme x:Key="NcQuietButton" TargetType="Button" BasedOn="{StaticResource NcPrimaryButton}">
      <Setter Property="Background" Value="{DynamicResource QuietFillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QuietEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusQuiet}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^.big"><Setter Property="CornerRadius" Value="{StaticResource RadiusQuietBig}" /></Style>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" /></Style>
      <Style Selector="^:pressed"><Setter Property="Background" Value="{DynamicResource QuietHoverBrush}" /></Style>
    </ControlTheme>

    <!-- Link: tertiary text action -->
    <ControlTheme x:Key="NcLinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="{StaticResource TextBody}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="6,11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="FocusAdorner" Value="{StaticResource NcFocus}" />
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.16" Easing="CubicEaseOut" /></Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" /></Style>
    </ControlTheme>

    <!-- Square icon button (Settings gear) -->
    <ControlTheme x:Key="NcIconButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
      <Setter Property="Background" Value="{DynamicResource Surface2ClearBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="FocusAdorner" Value="{StaticResource NcFocus}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="Foreground" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      </Style>
      <Style Selector="^.active">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      </Style>
    </ControlTheme>

    <!-- Main tabs. Selection is drawn by the sliding indicator in MainWindow, so a tab only changes its text color. -->
    <ControlTheme x:Key="NcTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource SelInkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="18,7" />
      <!-- Rounded like the tab bar's sliding pill, so a selected App size / Speed units choice isn't a square block. -->
      <Setter Property="CornerRadius" Value="{StaticResource RadiusTab}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="10" Margin="-1" /></FocusAdornerTemplate>
      </Setter>
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
      <Style Selector="^:checked"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
    </ControlTheme>

    <!-- Choice card (radio with title + description), e.g. DNS goal -->
    <ControlTheme x:Key="NcOption" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftClearBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusButton}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="FocusAdorner" Value="{StaticResource NcFocus}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
              <Panel Width="16" Height="16" VerticalAlignment="Top" Margin="0,3,0,0">
                <Ellipse x:Name="Ring" Stroke="{DynamicResource Ink3Brush}" StrokeThickness="2" />
                <Ellipse x:Name="Pip" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Opacity="0" />
              </Panel>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" /></Style>
      <Style Selector="^:checked">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      </Style>
      <Style Selector="^:checked /template/ Ellipse#Ring"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
      <Style Selector="^:checked /template/ Ellipse#Pip"><Setter Property="Opacity" Value="1" /></Style>
    </ControlTheme>

    <!-- Checkbox (Boost "Choose Myself"): 18 px rounded box; ticked = accent fill with a dark check -->
    <ControlTheme x:Key="NcCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftClearBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink3Brush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="FocusAdorner" Value="{StaticResource NcFocus}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <!-- 22 px box column + 12 spacing, the same as a joined-card row's mark column, so texts line up. -->
          <Grid ColumnDefinitions="22,*" ColumnSpacing="12" Background="Transparent">
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" HorizontalAlignment="Center"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" VerticalAlignment="Center">
              <Path x:Name="Tick" Data="M2,7.5 L6,11.5 L13,3.5" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round" Opacity="0" />
            </Border>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Ink2Brush}" /></Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </Style>
      <Style Selector="^:checked /template/ Path#Tick"><Setter Property="Opacity" Value="1" /></Style>
    </ControlTheme>

    <!-- On/off switch (Settings → Check for updates), P8 choice "A": 46 × 26 track with a frosted-glass knob.
         On = soft blue track; off = faint glass track. The knob only slides with the "motion" class (reduced motion off). -->
    <!-- LOCKED (user, 2026-11-25): the Settings update switch. Do not change its look. -->
    <ControlTheme x:Key="NcSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="FocusAdorner" Value="{StaticResource NcFocus}" />
      <Setter Property="Background" Value="{DynamicResource SwitchTrackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SwitchTrackEdgeBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Track" CornerRadius="13" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <Border x:Name="Knob" Width="20" Height="20" CornerRadius="10" Margin="2,0" HorizontalAlignment="Left"
                    VerticalAlignment="Center" RenderTransform="translateX(0px)"
                    Background="{DynamicResource SwitchKnobBrush}" BorderBrush="{DynamicResource SwitchKnobEdgeBrush}" BorderThickness="1"
                    BoxShadow="inset 0 1 0 0 #66FFFFFF" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource SwitchOnBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SwitchOnEdgeBrush}" />
      </Style>
      <Style Selector="^:checked /template/ Border#Knob">
        <Setter Property="RenderTransform" Value="translateX(20px)" />
        <Setter Property="Background" Value="{DynamicResource SwitchOnKnobBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SwitchOnKnobEdgeBrush}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #E6FFFFFF, 0 1 3 0 #590B1726" />
      </Style>
      <Style Selector="^.motion /template/ Border#Knob">
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
          </Transitions>
        </Setter>
      </Style>
    </ControlTheme>

    <!-- Window caption buttons: the same family as the Settings gear (user, 2026-11-17): 36 × 36 rounded hover square,
         18 px icon, 1.8 px rounded strokes, centred in the title bar; close still turns red on hover. -->
    <ControlTheme x:Key="NcCaption" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <BrushTransition Property="Foreground" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
      <Setter Property="Background" Value="{DynamicResource Surface2ClearBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Background="{TemplateBinding Background}" Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      </Style>
      <Style Selector="^.close">
        <Setter Property="Background" Value="{DynamicResource CloseHoverClearBrush}" />
      </Style>
      <Style Selector="^.close:pointerover">
        <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="NcChrome" TargetType="WindowDrawnDecorations">
      <Setter Property="DefaultTitleBarHeight" Value="56" />
      <Setter Property="DefaultFrameThickness" Value="1" />
      <Setter Property="DefaultShadowThickness" Value="0" />
      <Setter Property="Template">
        <WindowDrawnDecorationsTemplate>
          <WindowDrawnDecorationsContent>
            <WindowDrawnDecorationsContent.Underlay>
              <Border BorderThickness="{TemplateBinding FrameThickness}" BorderBrush="{DynamicResource LineBrush}" />
            </WindowDrawnDecorationsContent.Underlay>
            <WindowDrawnDecorationsContent.Overlay>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Spacing="4"
                          Margin="0,0,12,0" Height="{TemplateBinding TitleBarHeight}">
                <Button x:Name="PART_MinimizeButton" Theme="{StaticResource NcCaption}" ToolTip.Tip="Minimise"
                        WindowDecorationProperties.ElementRole="MinimizeButton" AutomationProperties.Name="Minimize">
                  <!-- A fixed 24 × 24 canvas: a bare Path measures from 0 to its far edge, which pushed the icon
                       down/right inside the hover square (user, 2026-11-17). -->
                  <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                      <Path Data="M5,12 L19,12" StrokeThickness="1.8" StrokeLineCap="Round"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                  </Viewbox>
                </Button>
                <Button x:Name="PART_CloseButton" Theme="{StaticResource NcCaption}" Classes="close" ToolTip.Tip="Close"
                        WindowDecorationProperties.ElementRole="CloseButton" AutomationProperties.Name="Close">
                  <!-- A fixed 24 × 24 canvas: a bare Path measures from 0 to its far edge, which pushed the icon
                       down/right inside the hover square (user, 2026-11-17). -->
                  <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                      <Path Data="M6,6 L18,18 M18,6 L6,18" StrokeThickness="1.8" StrokeLineCap="Round"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </StackPanel>
            </WindowDrawnDecorationsContent.Overlay>
          </WindowDrawnDecorationsContent>
        </WindowDrawnDecorationsTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!-- Typography roles -->
  <!-- Inter's figures are proportional by default; tabular figures keep counting numbers from wobbling in width. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{StaticResource TextHeadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBlock.lede">
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="600" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
  </Style>
  <Style Selector="TextBlock.optTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
  </Style>
  <Style Selector="TextBlock.optText">
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="24" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Page frame (page-patterns + typography skills): every page centres its content, capped at 1000 px,
       with the same title / lead / meta hierarchy. Sizes: 14 meta · 16 lead · 30 title. -->
  <Style Selector="TextBlock.pageTitle">
    <!-- Light titles (user choice 2026-11-16): thin yet clear, like the DNS name in the result strip. -->
    <Setter Property="FontSize" Value="36" />
    <!-- Trimmed to the letters (cap top to baseline) so layout gaps equal the space the eye sees (2026-11-17). -->
    <Setter Property="Margin" Value="0,-8,0,-8" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="LetterSpacing" Value="-0.3" />
    <!-- No fixed LineHeight: a fixed 36 px line at 30 px once clipped "g", "y" and "p" descenders (Manrope); Inter needs ~1.21 em. -->
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="680" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBlock.pageLead">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LineHeight" Value="26" />
    <!-- Trimmed to the letters like page titles. -->
    <Setter Property="Margin" Value="0,-7,0,-6" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <!-- 680 (was 560) so the one line under a title stays one line at the +2 px text size (2026-11-17). -->
    <Setter Property="MaxWidth" Value="680" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
  </Style>
  <Style Selector="TextBlock.tileLabel">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
  </Style>
  <Style Selector="TextBlock.tileText">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Panel.page">
    <Setter Property="MaxWidth" Value="1000" />
    <Setter Property="Margin" Value="48,0,48,32" />
  </Style>
</Styles>
