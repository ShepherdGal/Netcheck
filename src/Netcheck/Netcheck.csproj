<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Netcheck.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Win32" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.6" />
    <AvaloniaResource Include="Assets/Netcheck.ico" />
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <ProjectReference Include="../Netcheck.Measurements/Netcheck.Measurements.csproj" />
    <ProjectReference Include="../Netcheck.Windows/Netcheck.Windows.csproj" />
    <ProjectReference Include="../Netcheck.Storage/Netcheck.Storage.csproj" />
    <ProjectReference Include="../Netcheck.Optimization/Netcheck.Optimization.csproj" />
    <ProjectReference Include="../Netcheck.Elevation/Netcheck.Elevation.csproj" />
    <!-- Licence texts live inside the exe (P14); Settings → Open-Source Licences shows them. -->
    <EmbeddedResource Include="Licenses/*.txt" LogicalName="Licenses/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- One-file build (P14): the native libraries ride inside Netcheck.dll as resources and are unpacked by
       NativeLibraries.cs after a SHA-256 check (never to %TEMP%), so the published folder holds only Netcheck.exe. -->
  <PropertyGroup>
    <NetcheckNatives>;libskiasharp.dll;libharfbuzzsharp.dll;av_libglesv2.dll;microsoft.management.infrastructure.native.unmanaged.dll;</NetcheckNatives>
  </PropertyGroup>
  <Target Name="EmbedNativeLibraries" AfterTargets="ResolvePackageAssets" BeforeTargets="PrepareResources">
    <ItemGroup>
      <_NetcheckNativeFound Include="@(NativeCopyLocalItems)"
        Condition="$(NetcheckNatives.Contains(';$([System.String]::Copy('%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)').ToLowerInvariant());'))" />
      <EmbeddedResource Include="@(_NetcheckNativeFound)" LogicalName="Native/%(Filename)%(Extension)" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
    <Error Condition="'@(_NetcheckNativeFound->Count())' != '4'" Text="Expected 4 native libraries to embed, found: @(_NetcheckNativeFound->'%(Filename)%(Extension)')." />
  </Target>
  <Target Name="ExcludeEmbeddedNatives" AfterTargets="ComputeFilesToPublish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$(NetcheckNatives.Contains(';$([System.String]::Copy('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)').ToLowerInvariant());'))" />
    </ItemGroup>
  </Target>
  <!-- Native NuGet packages include large debugging symbols. Keep symbols in
       development caches, not in the runnable distribution. -->
  <Target Name="ExcludePublishSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>



