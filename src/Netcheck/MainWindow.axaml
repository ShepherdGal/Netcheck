<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nc="using:Netcheck.Controls"
        x:Class="Netcheck.MainWindow"
        Title="Netcheck" Icon="/Assets/Netcheck.ico"
        Width="1120" Height="920" CanResize="False" CanMaximize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="56"
        WindowDecorationsTheme="{StaticResource NcChrome}"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource TextBody}">
  <!-- Fixed-size window. The glow is drawn at the real window size (outside the scaler) so it looks the same at
       every app size; everything else is laid out at 1120 × 920 and scaled evenly by Settings → App size. -->
  <Panel>
    <nc:GlowBackdrop />
    <LayoutTransformControl x:Name="Scaler">
  <Grid RowDefinitions="56,Auto,*" Width="1120" Height="920">
    <!-- Drag area for the whole bar; interactive controls sit above it. -->
    <Border Grid.Row="0" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar" />

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="20,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
        <Viewbox Width="22" Height="22">
          <Canvas Width="24" Height="24">
            <!-- Two arcs = the two gauges (download, upload) meeting at the needle hub. -->
            <Path Data="M4.5,16 A7.5,7.5 0 0 1 11.5,8.5" Stroke="{StaticResource DownToBrush}" StrokeThickness="2.2" StrokeLineCap="Round" />
            <Path Data="M19.5,16 A7.5,7.5 0 0 0 14.5,8.9" Stroke="{StaticResource UpFromBrush}" StrokeThickness="2.2" StrokeLineCap="Round" />
            <Ellipse Canvas.Left="10.2" Canvas.Top="14.2" Width="3.6" Height="3.6" Fill="{StaticResource InkBrush}" />
          </Canvas>
        </Viewbox>
        <TextBlock x:Name="BrandText" Text="Netcheck" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" />
      </StackPanel>

      <Button Grid.Column="2" x:Name="SettingsButton" Theme="{StaticResource NcIconButton}"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,92,0"
              AutomationProperties.Name="Settings" ToolTip.Tip="Settings">
        <Panel Width="18" Height="18">
        <!-- Green dot: a verified newer release is ready (cleared once Settings has been opened). -->
        <Ellipse x:Name="UpdateDot" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-4,-5,0" Fill="{StaticResource GoodBrush}" Stroke="{StaticResource BgBrush}" StrokeThickness="2"
                 IsVisible="False" IsHitTestVisible="False" ZIndex="1" />
        <Viewbox Width="18" Height="18">
          <Canvas Width="24" Height="24">
          <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round"
                Data="M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z M19.4,15 a1.7,1.7 0 0 0 .3,1.8 l.1,.1 a2,2 0 1 1 -2.8,2.8 l-.1,-.1 a1.7,1.7 0 0 0 -1.8,-.3 a1.7,1.7 0 0 0 -1,1.5 V21 a2,2 0 1 1 -4,0 v-.1 a1.7,1.7 0 0 0 -1.1,-1.5 a1.7,1.7 0 0 0 -1.8,.3 l-.1,.1 a2,2 0 1 1 -2.8,-2.8 l.1,-.1 a1.7,1.7 0 0 0 .3,-1.8 a1.7,1.7 0 0 0 -1.5,-1 H3 a2,2 0 1 1 0,-4 h.1 a1.7,1.7 0 0 0 1.5,-1.1 a1.7,1.7 0 0 0 -.3,-1.8 l-.1,-.1 a2,2 0 1 1 2.8,-2.8 l.1,.1 a1.7,1.7 0 0 0 1.8,.3 H9 a1.7,1.7 0 0 0 1,-1.5 V3 a2,2 0 1 1 4,0 v.1 a1.7,1.7 0 0 0 1,1.5 a1.7,1.7 0 0 0 1.8,-.3 l.1,-.1 a2,2 0 1 1 2.8,2.8 l-.1,.1 a1.7,1.7 0 0 0 -.3,1.8 V9 a1.7,1.7 0 0 0 1.5,1 H21 a2,2 0 1 1 0,4 h-.1 a1.7,1.7 0 0 0 -1.5,1 Z" />
          </Canvas>
        </Viewbox>
        </Panel>
      </Button>
    </Grid>

    <!-- Tabs on their own row under the title bar (Check v2, 2026-11-16). -->
    <!-- Spacing scale (design rules): title-bar controls end at 46 px; ~32 px (visible) to the tab bar, 32 px from it to every page title. -->
    <Border Grid.Row="1" x:Name="NavFrame" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Padding="4"
            Background="{StaticResource SelBarBrush}" BorderBrush="{StaticResource SelBorderBrush}"
            BorderThickness="1" CornerRadius="14">
      <Panel>
        <Border x:Name="TabIndicator" HorizontalAlignment="Left" Width="0" CornerRadius="{StaticResource RadiusTab}"
                Background="{StaticResource SelPillBrush}" />
        <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="4">
          <RadioButton Theme="{StaticResource NcTab}" GroupName="MainTabs" Tag="check" Content="Check" IsChecked="True" />
          <RadioButton Theme="{StaticResource NcTab}" GroupName="MainTabs" Tag="dns" Content="DNS" />
          <RadioButton Theme="{StaticResource NcTab}" GroupName="MainTabs" Tag="boost" Content="Boost" />
          <RadioButton Theme="{StaticResource NcTab}" GroupName="MainTabs" Tag="history" Content="History" />
        </StackPanel>
      </Panel>
    </Border>

    <!-- 18 px of air under the tab bar on every page (user, 2026-11-17). -->
    <ContentControl Grid.Row="2" x:Name="PageHost" ClipToBounds="True" Margin="0,32,0,0" />

    <!-- The one confirm dialog (Clear history, Go back). Never nested; Escape or Cancel closes it. -->
    <Panel Grid.RowSpan="3" x:Name="ConfirmLayer" IsVisible="False">
      <Border Background="{StaticResource ScrimBrush}" />
      <Border Width="460" Padding="28,28,28,22" CornerRadius="18" Background="{StaticResource DialogBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1" BoxShadow="{StaticResource EdgeLight}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="ConfirmTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="ConfirmText" Margin="0,8,0,0" FontSize="17" LineHeight="24" TextWrapping="Wrap"
                     Foreground="{StaticResource Ink2Brush}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button x:Name="ConfirmCancel" Theme="{StaticResource NcQuietButton}" Content="Cancel" MinWidth="96" />
            <Button x:Name="ConfirmOk" Theme="{StaticResource NcPrimaryButton}" MinWidth="96" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
    </LayoutTransformControl>
  </Panel>
</Window>
